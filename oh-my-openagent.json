{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
  "disabled_hooks": [],
  "agents": {
    "sisyphus": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6",
      "variant": "max"
    },
    "oracle": {
      "model": "github-copilot/gpt-5.5",
      "variant": "high"
    },
    "librarian": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6"
    },
    "explore": {
      "model": "github-copilot/gpt-5.4-mini",
      "textVerbosity": "low"
    },
    "multimodal-looker": {
      "model": "github-copilot/gemini-3-flash-preview"
    },
    "prometheus": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-7",
      "variant": "xhigh"
    },
    "metis": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-6-v1",
      "variant": "xhigh"
    },
    "momus": {
      "model": "github-copilot/gpt-5.5",
      "variant": "xhigh"
    },
    "atlas": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6"
    },
    "hephaestus": {
      "model": "github-copilot/gpt-5.5"
    },
    "sisyphus-junior": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6"
    }
  },
  "sisyphus_agent": {
    "replace_plan": false
  },
  "experimental": {
    "preemptive_compaction": true,
    "disable_omo_env": true
  },
  "background_task": {
    "messageStalenessTimeoutMs": 120000,
    "staleTimeoutMs": 180000
  },
  "categories": {
    "visual-engineering": {
      "model": "github-copilot/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "github-copilot/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "artistry": {
      "model": "github-copilot/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "quick": {
      "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
      "textVerbosity": "low",
      "max_prompt_tokens": 8000
    },
    "unspecified-low": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6"
    },
    "unspecified-high": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6"
    },
    "deep": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-7",
      "variant": "xhigh"
    },
    "writing": {
      "model": "github-copilot/gemini-3-flash-preview",
      "max_prompt_tokens": 16000
    }
  }
}
 
